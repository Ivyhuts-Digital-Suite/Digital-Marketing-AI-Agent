# MongoDB connection string.
MONGO_URI=

# Secret used to sign/verify auth JWTs. Any long random string for local dev.
JWT_SECRET=

# Port the Express server listens on. Defaults to 5000 if unset.
PORT=5000

# ---------------------------------------------------------------------------
# Gemini (Google) - the backend's intelligence/reasoning provider.
# Required for: Company Intelligence, Content Intelligence, Creative Brief
# generation. Get a key at https://aistudio.google.com/apikey
# ---------------------------------------------------------------------------
GEMINI_API_KEY=

# Optional: overrides the default Gemini model for every call. Business
# services never hardcode a model id - see src/config/gemini.ts.
# GEMINI_MODEL=gemini-3.6-flash
# Optional Content Intelligence-only override. Use this to change plan and
# brief generation without changing other Gemini intelligence services.
# CONTENT_INTELLIGENCE_MODEL=gemini-3.6-flash
# Three total attempts for transient 429/503 only. Delays after failed
# attempts are 2 seconds then 5 seconds; later configured values are ignored.
# GEMINI_RETRY_DELAYS_MS=2000,5000,10000

# Optional: per-service model overrides, if a specific service should use a
# different Gemini model than GEMINI_MODEL.
# COMPANY_INTELLIGENCE_MODEL=
# CONTENT_INTELLIGENCE_MODEL=
# CONTENT_STUDIO_MODEL=

# ---------------------------------------------------------------------------
# Content Studio media generation. Gemini remains the intelligence provider;
# real image/video assets use Hugging Face. Keys are backend-only.
# ---------------------------------------------------------------------------

HUGGINGFACE_API_KEY=
# Set an image-capable model; this is intentionally not defaulted to Wan.
# Verified live: black-forest-labs/FLUX.1-schnell (fast, real image output).
HUGGINGFACE_IMAGE_MODEL=
# Verified live end-to-end 2026-09-15 (real MP4 downloaded via fal.ai/Wan).
# Do NOT use Wan-AI/Wan2.1-T2V-1.3B - Hugging Face's own partner mapping
# still lists it as "live", but fal.ai's queue API currently 404s on it
# ("Path /v2.1/1.3b/text-to-video not found") - a stale mapping on fal's
# side, not something this codebase can fix. Wan2.1-T2V-14B uses a flatter,
# working fal.ai route.
HUGGINGFACE_VIDEO_MODEL=Wan-AI/Wan2.1-T2V-14B
MEDIA_IMAGE_PROVIDER=huggingface
MEDIA_VIDEO_PROVIDER=huggingface
# HUGGINGFACE_MEDIA_TIMEOUT_MS=900000
# For automated tests only: MEDIA_IMAGE_PROVIDER=mock and/or MEDIA_VIDEO_PROVIDER=mock.

# Local development storage is browser-accessible at /uploads. Do not use it
# for multi-instance production deployments; substitute a durable storage
# provider behind FileStorageService.
STORAGE_PROVIDER=local
# STORAGE_LOCAL_DIR=uploads
# STORAGE_PUBLIC_BASE_URL=http://localhost:5000

# ---------------------------------------------------------------------------
# OpenAI - NOT used for intelligence/reasoning anymore. Still required for:
#   1. Knowledge base embeddings (src/services/embedding) - Gemini's
#      embeddings would require a separate integration, so this stays on
#      OpenAI regardless of the above.
# Leave unset if you don't use website/document ingestion. Company/Content
# Intelligence and Creative Brief generation do not need this key at all.
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
# EMBEDDING_MODEL=text-embedding-3-small
