# MongoDB Atlas connection string used by every script/service that
# talks to the database (models, integrationsServer.js, test/cleanup scripts).
# (MONGO_URI, as used by the main backend, is also accepted)
MONGODB_URI=

# 32-byte key (64 hex characters) used by IntegrationCredentialService
# for AES-256-GCM encryption of stored integration credentials. Generate
# with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CREDENTIAL_ENCRYPTION_KEY=

# Port the standalone integrations Express server (src/integrationsServer.js) listens on. Defaults to 3001
# if unset.
PORT=

# Meta / Instagram (not yet used — MetaInstagramAdapter is currently a mock)
# META_APP_ID=
# META_APP_SECRET=
# META_ACCESS_TOKEN=
# META_WEBHOOK_VERIFY_TOKEN=

# Google Ads (not yet used — MockGoogleAdsAdapter is currently a mock)
# GOOGLE_ADS_CLIENT_ID=
# GOOGLE_ADS_CLIENT_SECRET=
# GOOGLE_ADS_DEVELOPER_TOKEN=

# Email provider (not yet used — MockEmailAdapter is currently a mock)
# EMAIL_PROVIDER_API_KEY=

# CRM provider (not yet used — MockCRMAdapter is currently a mock)
# CRM_PROVIDER_API_KEY=
